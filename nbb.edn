;; The kbb engine (kotoba-lang/org-babashka-nbb) reads THIS file, found by
;; walking up from the script's path -- so `itonami status` typed anywhere
;; still finds it. It does NOT read deps.edn: a coordinate declared only
;; there is invisible to `bin/itonami` (measured 2026-09-15: without this
;; file the launcher died in `Could not find namespace: kotoba.lang.text`).
;;
;; :paths and the sha below are COPIED from deps.edn, not chosen here.
{:paths ["src" "bin" "resources"]
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.edn"}
       io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}
        ;; The command surface: cloud.itonami.app.commands / .repo-profile and
        ;; the three tables. Advance this sha when the app regenerates the
        ;; registry (cloud-itonami-commands README, "Who writes the registry").
        io.github.cloud-itonami/cloud-itonami-commands {:git/sha "e6ce98e94908b002afe077aa7f83f9bbcf7b5281"}}}
